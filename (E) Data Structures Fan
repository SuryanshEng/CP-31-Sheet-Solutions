#include <bits/stdc++.h>
using namespace std;

int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t; cin >> t;
    while(t--){
        int n; cin >> n;
        vector<int> pre(n + 1, 0);
        for(int i = 1; i <= n; i++){
            int x; cin >> x;
            pre[i] = pre[i - 1] ^ x;
        }
        string s; cin >> s;
        int x1 = 0;
        for(int i = 1; i <= n; i++) if(s[i - 1] == '1') x1 ^= pre[i] ^ pre[i - 1];
        int X = pre[n];
        int q; cin >> q;
        while(q--){
            int tp; cin >> tp;
            if(tp == 1){
                int l, r; cin >> l >> r;
                x1 ^= pre[r] ^ pre[l - 1];
            } else {
                int g; cin >> g;
                cout << (g ? x1 : (X ^ x1)) << " ";
            }
        }
        cout << "\n";
    }
}
