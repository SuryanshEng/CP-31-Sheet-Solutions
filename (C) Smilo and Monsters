#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t; cin >> t;
    while(t--){
        int n; cin >> n;
        vector<ll> a(n);
        ll S = 0;
        for(auto &x : a){ cin >> x; S += x; }
        sort(a.rbegin(), a.rend());
        ll h = S / 2, rem = h, ult = 0;
        for(int i = 0; i < n && rem > 0; i++){
            rem -= min(rem, a[i]);
            ult++;
        }
        cout << (S - h) + ult << "\n";
    }
}
