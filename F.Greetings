#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    scanf("%d", &t);
    while (t--) {
        int n;
        scanf("%d", &n);
        vector<pair<int,int>> p(n);
        for (auto &x : p) scanf("%d %d", &x.first, &x.second);
        sort(p.begin(), p.end());

        vector<int> b(n);
        for (int i = 0; i < n; i++) b[i] = p[i].second;
        vector<int> s = b;
        sort(s.begin(), s.end());

        vector<int> bit(n + 1, 0);
        long long ans = 0;
        for (int i = 0; i < n; i++) {
            int r = lower_bound(s.begin(), s.end(), b[i]) - s.begin() + 1;
            int le = 0;
            for (int x = r; x > 0; x -= x & -x) le += bit[x];
            ans += i - le;
            for (int x = r; x <= n; x += x & -x) bit[x]++;
        }
        printf("%lld\n", ans);
    }
    return 0;
}
